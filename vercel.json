{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "health.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/health", "dest": "/health.json" },
    { "src": "/health.json", "dest": "/health.json" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
