{
  "name": "richo-systems-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:billing": "node --test tests/billing-security-contract.mjs tests/storage-security-contract.mjs",
    "test:stripe-mock": "node --test tests/stripe-mock-integration.mjs",
    "test:integration-boundaries": "node --test tests/integration-boundaries.mjs",
    "test:preproduction": "node --test tests/preproduction-readiness-contract.mjs",
    "test:legacy-marketplace": "node tests/db_migrations.test.js && node tests/marketplace_webhook_handler.test.js && node tests/marketplace_webhook_handler.idempotency.test.js && node tests/webhook_signature.integration.test.js && node tests/stripe_integration.test.js && node tests/stripe_connect.integration.test.js",
    "test:github-app": "npm --prefix github-app test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "4.22.2",
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.5.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "supabase": "2.113.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "6.0.3"
  }
}
