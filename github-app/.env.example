PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Canonical GitHub Marketplace service database only. This database must not be
# the Supabase customer-commerce database and must not be the legacy
# LEGACY_MARKETPLACE_DATABASE_URL database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/richo_github_app
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# GitHub App
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Set one of the following. Never commit a real private key.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_B64=

# Application security
SESSION_SECRET=
ADMIN_TOKEN=
