# R.I.C.H.O. GitHub Marketplace staging rehearsal environment
# TEMPLATE ONLY. Do not place real values in this file.
# Provisioning, secret installation and external callback/webhook changes require separate owner approval.

PORT=3000
PUBLIC_BASE_URL=https://STAGING_HOST

# Dedicated staging Marketplace PostgreSQL only.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Staging/test GitHub App identity only.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_B64=

# Staging-only application security material.
SESSION_SECRET=
ADMIN_TOKEN=

# Explicit environment identity. Rehearsal tooling rejects production labels.
RICHO_ENVIRONMENT=staging
RICHO_LIVE_PAYMENTS_ENABLED=false
RICHO_CONNECT_ENABLED=false
RICHO_PAYOUTS_ENABLED=false
