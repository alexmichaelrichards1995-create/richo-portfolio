NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server only. Prefer a modern Supabase sb_secret_ key. Legacy service_role is
# supported only as a compatibility fallback and must never be exposed publicly.
SUPABASE_SECRET_KEY=sb_secret_your_server_key_here
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Stripe restricted key and webhook signing secret.
STRIPE_RESTRICTED_KEY=rk_test_your_restricted_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Canonical origin used for Stripe Checkout success/cancel redirects.
SITE_URL=http://localhost:3000
