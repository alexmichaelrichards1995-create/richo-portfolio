# Customer commerce — Supabase / Next.js only
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server only. Prefer a modern Supabase sb_secret_ key. Legacy service_role is
# supported only as a compatibility fallback and must never be exposed publicly.
SUPABASE_SECRET_KEY=sb_secret_your_server_key_here
SUPABASE_SERVICE_ROLE_KEY=

# Customer-commerce Stripe defaults to test mode. The key prefix must match
# STRIPE_MODE. Live operations additionally require the second explicit gate.
STRIPE_MODE=test
RICHO_LIVE_PAYMENTS_ENABLED=false
STRIPE_RESTRICTED_KEY=rk_test_your_restricted_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional local/CI request-shape testing with stripe-mock only. Never point
# these values at api.stripe.com and never enable mock transport in live mode.
STRIPE_TEST_MOCK_ENABLED=false
STRIPE_TEST_MOCK_HOST=127.0.0.1
STRIPE_TEST_MOCK_PORT=12111

# Canonical origin used for Checkout success/cancel/portal redirects.
SITE_URL=http://localhost:3000

# Legacy GitHub Marketplace compatibility lane only.
# This MUST be a dedicated database. Do not point it at Supabase customer
# commerce or the canonical github-app database.
LEGACY_MARKETPLACE_DATABASE_URL=
ALLOW_FILE_STORE=false
GITHUB_WEBHOOK_SECRET=

# Legacy Marketplace Stripe Connect compatibility. These gates are OFF by
# default and are intentionally separate from customer-commerce Stripe.
STRIPE_CONNECT_SECRET_KEY=
RICHO_MARKETPLACE_CONNECT_ENABLED=false
RICHO_LIVE_PAYOUTS_ENABLED=false

# Canonical GitHub Marketplace service lives under github-app/ and has its own
# github-app/.env.example plus service-local DATABASE_URL. Do not reuse the
# customer Supabase database or LEGACY_MARKETPLACE_DATABASE_URL for it.
