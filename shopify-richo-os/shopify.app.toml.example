# R.I.C.H.O. Shopify Operations OS
# Link this config with `shopify app config link` after creating the app in Shopify.

client_id = ""
name = "R.I.C.H.O. Operations OS"
application_url = "https://example.invalid"
embedded = true

[build]
automatically_update_urls_on_dev = true
include_config_on_deploy = true

[access_scopes]
# read_reports is required for shopifyqlQuery analytics.
# read_customers / read_orders / read_products support the Mission Control evidence model.
scopes = "read_products,read_orders,read_customers,read_reports"

[webhooks]
api_version = "2026-07"

[[webhooks.subscriptions]]
topics = ["app/uninstalled"]
uri = "/webhooks/app/uninstalled"

[[webhooks.subscriptions]]
topics = ["app/scopes_update"]
uri = "/webhooks/app/scopes_update"

[auth]
redirect_urls = ["https://example.invalid/auth/callback"]
