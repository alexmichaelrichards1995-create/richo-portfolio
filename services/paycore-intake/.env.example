# Server-only secrets. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DATABASE_URL=
PAYCORE_PII_ENCRYPTION_KEY=
EMAIL_HASH_PEPPER=

# Public origin used for post-checkout return URLs.
NEXT_PUBLIC_SITE_URL=https://richo-paycore-intake-api.vercel.app

# Optional account pin. Health and payment paths fail closed if the key belongs to another account.
STRIPE_EXPECTED_ACCOUNT_ID=

# Optional comma-separated trusted browser origins for Checkout creation.
CHECKOUT_ALLOWED_ORIGINS=https://richosystems.technology
